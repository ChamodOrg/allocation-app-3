  "description": "The one backend of the Allocations App, called by the browser app through the gateway. It serves engagements and approvals, consultant and team allocations with their clearance rules, the dashboard counts and the consultant allocations report by composing the finance, HR, sales and skills systems, and sends notifications. It owns in its own Postgres database the allocation types, partner consultants, funding lookups, engagement code data, access roles with their privileges and the audit log. It is one service because every capability shares one data model and one release cycle. It does not sign users in, hold consultant accounts, book travel or send mail itself.",
  "dependencies": [
    {
      "kind": "platform-resource",
      "name": "user-auth",
      "resourceType": "thunder-app",
      "wiring": {
        "ref": "allocation-app-3-user-auth",
        "envBindings": {
          "client_id": "USER_AUTH_CLIENT_ID",
          "issuer": "USER_AUTH_ISSUER",
          "jwks_url": "USER_AUTH_JWKS_URL",
          "resource": "USER_AUTH_RESOURCE",
          "scopes": "USER_AUTH_SCOPES"
        }
      }
    },
    {
      "kind": "platform-resource",
      "name": "allocations-db",
      "resourceType": "postgres-cnpg",
      "wiring": {
        "ref": "allocation-app-3-bcc02928",
        "envBindings": {
          "dbname": "ALLOCATIONS_DB_DBNAME",
          "host": "ALLOCATIONS_DB_HOST",
          "password": "ALLOCATIONS_DB_PASSWORD",
          "port": "ALLOCATIONS_DB_PORT",
          "user": "ALLOCATIONS_DB_USER"
        }
      }
    },
    {
      "kind": "external",
      "name": "finance-entity-service",
      "description": "System of record for engagements, allocations and visas: every engagement and allocation is read from and written to it over GraphQL.",
      "wiring": {
        "ref": "allocation-app-3-9eea053c",
        "envBindings": {
          "FINANCE_ENTITY_SERVICE_CLIENT_ID": "FINANCE_ENTITY_SERVICE_CLIENT_ID",
          "FINANCE_ENTITY_SERVICE_CLIENT_SECRET": "FINANCE_ENTITY_SERVICE_CLIENT_SECRET",
          "FINANCE_ENTITY_SERVICE_TOKEN_URL": "FINANCE_ENTITY_SERVICE_TOKEN_URL",
          "FINANCE_ENTITY_SERVICE_URL": "FINANCE_ENTITY_SERVICE_URL"
        }
      }
    },
    {
      "kind": "external",
      "name": "hr-entity-service",
      "description": "Reads employees, org structure and reporting leads to find people to allocate and to address notifications.",
      "wiring": {
        "ref": "allocation-app-3-9a416edc",
        "envBindings": {
          "HR_ENTITY_SERVICE_CLIENT_ID": "HR_ENTITY_SERVICE_CLIENT_ID",
          "HR_ENTITY_SERVICE_CLIENT_SECRET": "HR_ENTITY_SERVICE_CLIENT_SECRET",
          "HR_ENTITY_SERVICE_TOKEN_URL": "HR_ENTITY_SERVICE_TOKEN_URL",
          "HR_ENTITY_SERVICE_URL": "HR_ENTITY_SERVICE_URL"
        }
      }
    },
    {
      "kind": "external",
      "name": "sales-entity-service",
      "description": "Reads CRM accounts, opportunities and product line items from which a paid customer engagement is raised.",
      "wiring": {
        "ref": "allocation-app-3-a09889ee",
        "envBindings": {
          "SALES_ENTITY_SERVICE_CLIENT_ID": "SALES_ENTITY_SERVICE_CLIENT_ID",
          "SALES_ENTITY_SERVICE_CLIENT_SECRET": "SALES_ENTITY_SERVICE_CLIENT_SECRET",
          "SALES_ENTITY_SERVICE_TOKEN_URL": "SALES_ENTITY_SERVICE_TOKEN_URL",
          "SALES_ENTITY_SERVICE_URL": "SALES_ENTITY_SERVICE_URL"
        }
      }
    },
    {
      "kind": "external",
      "name": "email-notifications-service",
      "description": "Sends the templated notices for engagement and allocation lifecycle events.",
      "wiring": {
        "ref": "allocation-app-3-b290c363",
        "envBindings": {
          "EMAIL_NOTIFICATIONS_SERVICE_APP_ID": "EMAIL_NOTIFICATIONS_SERVICE_APP_ID",
          "EMAIL_NOTIFICATIONS_SERVICE_CLIENT_ID": "EMAIL_NOTIFICATIONS_SERVICE_CLIENT_ID",
          "EMAIL_NOTIFICATIONS_SERVICE_CLIENT_SECRET": "EMAIL_NOTIFICATIONS_SERVICE_CLIENT_SECRET",
          "EMAIL_NOTIFICATIONS_SERVICE_TOKEN_URL": "EMAIL_NOTIFICATIONS_SERVICE_TOKEN_URL",
          "EMAIL_NOTIFICATIONS_SERVICE_URL": "EMAIL_NOTIFICATIONS_SERVICE_URL"
        }
      }
    },
    {
      "kind": "external",
      "name": "servicenow-consultant-skills",
      "description": "Reads the skills register and finds consultants who hold given skills.",
      "wiring": {
        "ref": "allocation-app-3-102e7e22",
        "envBindings": {
          "SERVICENOW_CONSULTANT_SKILLS_CLIENT_ID": "SERVICENOW_CONSULTANT_SKILLS_CLIENT_ID",
          "SERVICENOW_CONSULTANT_SKILLS_CLIENT_SECRET": "SERVICENOW_CONSULTANT_SKILLS_CLIENT_SECRET",
          "SERVICENOW_CONSULTANT_SKILLS_TOKEN_URL": "SERVICENOW_CONSULTANT_SKILLS_TOKEN_URL",
          "SERVICENOW_CONSULTANT_SKILLS_URL": "SERVICENOW_CONSULTANT_SKILLS_URL"
        }
      }
    }
  ],
  "exposesAPI": {
    "auth": "end-user-required"
  },
  "skillsPinned": [
    "openapi-conventions",
    "ballerina",
    "thunder-authentication",
    "api-management"
  ]
}
